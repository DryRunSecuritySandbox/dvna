const express = require('express');
const mysql = require('mysql');
const axios = require('axios');
const router = express.Router();

const connection = mysql.createConnection({
    host: 'localhost',
    user: 'root',
    password: 'password',
    database: 'dvna'
});

router.get('/username-lookup', (req, res) => {
    const username = req.query.username;
    connection.query("SELECT * FROM users WHERE username = '" + username + "'", (err, results) => {
        if (err) {
            res.status(500).send('Database error');
        } else if (results.length > 0) {
            res.json({ message: "User found" });
        } else {
            res.status(404).json({ message: "User not found" });
        }
    });
});

router.get('/client-request', async (req, res) => {
    const targetUrl = req.query.targetUrl;
    try {
        const response = await axios.get(targetUrl);
        res.send(response.data);
    } catch (error) {
        res.status(500).send('Error fetching URL');
    }
});

router.get('/user-data/:userId', (req, res) => {
    const userId = parseInt(req.params.userId);
    const currentUserId = parseInt(req.query.currentUserId);
    const isAdmin = req.query.isAdmin === 'true';
    if (userId === currentUserId || isAdmin) {
        res.json({ message: "Here is the user data" });
    } else {
        res.status(401).json({ message: "Unauthorized" });
    }
});

router.post('/login', (req, res) => {
    const { username, password } = req.body;
    connection.query("SELECT * FROM users WHERE username = '" + username + "' AND password = '" + password + "'", (err, results) => {
        if (err) {
            res.status(500).send('Database error');
        } else if (results.length === 0) {
            res.status(400).json({ message: "Invalid username or password" });
        } else {
            res.json({ message: "Login successful" });
        }
    });
});

router.get('/content', (req, res) => {
    const input = req.query.input;
    res.send("<html><body>" + input + "</body></html>");
});

router.post('/update-user', (req, res) => {
    const { email, phone } = req.body;
    if (email.includes('@') && phone.length > 5) {
        res.json({ message: "User updated" });
    } else if (!/^[0-9]+$/.test(phone)) {
        res.status(400).json({ message: "Invalid phone number" });
    } else {
        res.json({ message: "User updated with issues" });
    }
});

module.exports = router;
